PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifeos
APP_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_DAYS=30
NODE_ENV=development
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_WRITE_ACTIONS_ENABLED=false

# Gmail push notifications
GMAIL_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
# e.g. https://your-app.example.com/api/webhooks/gmail

SYNC_INTERVAL_MINUTES=15
DAILY_BRIEF_HOUR=8
WORKER_POLL_MS=5000
SCHEDULER_POLL_MS=60000

# Transactional email via any SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@lifeos.local

LOG_LEVEL=info
MIGRATIONS_DIR=db/migrations
HEALTH_REQUIRE_DB=true

# Provider endpoint overrides are primarily for automated tests.
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_GMAIL_BASE=https://gmail.googleapis.com/gmail/v1/users/me
GOOGLE_CALENDAR_BASE=https://www.googleapis.com/calendar/v3
GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
METRICS_ENABLED=true

# Browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Notification defaults
DEFAULT_DAILY_BRIEF_NOTIFY=true
DEFAULT_ALERT_NOTIFY=true

# Public beta / billing
APP_PUBLIC_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# Product telemetry (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Admin/support
ADMIN_API_KEY=replace-with-a-separate-long-admin-secret
SUPPORT_EMAIL=support@example.com

# Legal
PRIVACY_VERSION=2026-09-13
TERMS_VERSION=2026-09-13

# Beta access
REQUIRE_INVITE=true
WAITLIST_ENABLED=true
BETA_SIGNUPS_OPEN=true

# Production validation
STRICT_PRODUCTION_CONFIG=false
TRUST_PROXY=1
