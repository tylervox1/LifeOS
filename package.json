{
  "name": "lifeos-v2.5",
  "version": "3.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "worker": "node server/worker.js",
    "scheduler": "node server/scheduler.js",
    "migrate": "node server/migrate.js",
    "test": "node --test",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "mobile:sync": "npx cap sync",
    "mobile:add:ios": "npx cap add ios",
    "mobile:add:android": "npx cap add android",
    "beta:check": "node scripts/beta-check.js",
    "launch:check": "node scripts/launch-check.js",
    "smoke": "node scripts/smoke.js",
    "scheduler:once": "SCHEDULER_ONESHOT=true node server/scheduler.js",
    "verify:repo": "node scripts/verify-repo.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7",
    "@capacitor/core": "^7.4.0",
    "stripe": "^18.5.0",
    "@sentry/node": "^9.38.0",
    "posthog-node": "^5.8.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "@capacitor/cli": "^7.4.0"
  }
}
